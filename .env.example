# Payment-link checkout (/payments/:code).
# Production build: the Comet-dashboard API the browser calls. That API's
# CORS_ALLOWED_ORIGINS must include this site's origin. Defaults to
# https://cometapi.mamlakapsp.com when unset.
VITE_COMET_API_URL=
# Dev server only: where /api is proxied. Defaults to http://localhost:8092.
COMET_API_URL=
